app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Private keys
nusa_key.private

# Build reports
/android/build/reports/
/android/.kotlin/

# APK builds (too large for GitHub)
*.apk
nusa_builds/

# Build script backup files (restored after each variant build)
*.orig

# Supabase CLI temp state (nested working copy)
supabase/supabase/
.freebuff/

# Backup fixture DB (data user asli — JANGAN pernah di-commit)
test/fixtures/*.sqlite
