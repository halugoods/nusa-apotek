<?xml version="1.0" encoding="utf-8"?>
<!-- Tech list for nfc_manager fallback dispatch.
     Lists all tag technologies this app can handle.
     When enableReaderMode() fails to engage in time,
     Android dispatches the tag intent here instead of
     to DANA or other NFC apps. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <tech-list>
        <!-- NTAG215 / NTAG21x series -->
        <tech>android.nfc.tech.NfcA</tech>
        <tech>android.nfc.tech.Ndef</tech>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>
    <tech-list>
        <!-- Mifare Classic 1K/4K -->
        <tech>android.nfc.tech.MifareClassic</tech>
        <tech>android.nfc.tech.NfcA</tech>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>
    <tech-list>
        <!-- Any NfcA tag (fallback) -->
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>
</resources>
