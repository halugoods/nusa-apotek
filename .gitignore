# ── Root C:/ ignore (repo worktree = C:/) ─────────────────────────────
# Lepas folder non-proyek dari git status. File di disk TIDAK dihapus.

# Hanya proyek ini yang dilacak: Users/ertyui/ZCodeProject/nusa_kasir/
# (dan .gitignore di root ini sendiri)
/*.log.tmp

# Windows system dirs & junctions di root C:/
/Documents and Settings/
/OneDriveTemp/
/Program Files/
/Program Files (x86)/
/ProgramData/
/Recovery/
/\$GetCurrent/
/\$Recycle.Bin/
/System Volume Information/
/DumpStack.log.tmp

# Semua folder di /Users/ kecuali ertyui
/Users/*
!/Users/ertyui/

# Semua isi home user kecuali ZCodeProject
/Users/ertyui/*
!/Users/ertyui/ZCodeProject/

# Semua isi ZCodeProject kecuali nusa_kasir
/Users/ertyui/ZCodeProject/*
!/Users/ertyui/ZCodeProject/nusa_kasir/

